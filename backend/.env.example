DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=hrms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# Email delivery. Keep local development on console output unless you are
# explicitly testing SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=20
DJANGO_DEFAULT_FROM_EMAIL=hrms@example.local
DJANGO_SERVER_EMAIL=hrms@example.local

# Amazon SES sandbox SMTP example:
# 1. Verify sender/domain in SES.
# 2. Verify every test recipient while account remains in sandbox.
# 3. Store SMTP username/password in your deployment secret manager.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# DJANGO_EMAIL_HOST_USER=<ses-smtp-username>
# DJANGO_EMAIL_HOST_PASSWORD=<ses-smtp-password>
# DJANGO_DEFAULT_FROM_EMAIL=Nexora HRMS <notifications@verified-domain.example>
# DJANGO_SERVER_EMAIL=Nexora HRMS <notifications@verified-domain.example>

# Payroll production provider configuration:
# - keep real secret material in the deployment secret manager
# - use credential refs in tenant/provider records and route config
# - see docs/payroll-production-env-template.md for sanitized examples
# HRMS_PAYROLL_PROVIDER_CREDENTIALS_JSON={}
# HRMS_PAYROLL_ARTIFACT_STORAGE_CREDENTIALS_JSON={}
# HRMS_PAYROLL_ARTIFACT_STORAGE_POLICIES_JSON={}
