# HRMS Payroll SaaS Staging Launch Sign-Off Environment
#
# Copy the key names into your shell or secret-backed CI environment.
# Do not commit real passwords, tokens, provider credentials, storage keys, or private URLs.

# Required for staging sign-off browser/API proxy execution.
HRMS_API_BASE_URL=https://staging.example.com/api/v1
PLAYWRIGHT_LIVE_SEED_PASSWORD=

# Optional seeded persona overrides. Defaults are the local demo seed usernames.
PLAYWRIGHT_LIVE_HR_ADMIN_USERNAME=nisha.rao
PLAYWRIGHT_LIVE_EMPLOYEE_USERNAME=riya.sharma

# Optional bearer token for non-cookie automation routes.
HRMS_API_BEARER_TOKEN=

# Set this only when disposable live mutation records have been seeded.
PLAYWRIGHT_LIVE_MUTATIONS=false

# Required only when PLAYWRIGHT_LIVE_MUTATIONS=true.
# Generate disposable values with:
#   pnpm qa:staging-seed
# The staging sign-off runner reads web/qa-artifacts/staging-launch-seed/manifest.json automatically when it exists.
# Remove only those disposable values with:
#   pnpm qa:staging-seed:cleanup
PLAYWRIGHT_LIVE_RETRY_NOTIFICATION_ID=
PLAYWRIGHT_LIVE_EMPLOYEE_NOTIFICATION_ID=
PLAYWRIGHT_LIVE_PAYSLIP_ID=

# Required for production mode. Usually optional in staging unless the tenant is proving provider/storage controls end to end.
HRMS_PAYROLL_PROVIDER_CREDENTIALS_JSON=
HRMS_PAYROLL_ARTIFACT_STORAGE_CREDENTIALS_JSON=
HRMS_PAYROLL_ARTIFACT_STORAGE_POLICIES_JSON=
PAYROLL_ARTIFACT_STORAGE_CONTROL_VERIFICATION_MODE=
