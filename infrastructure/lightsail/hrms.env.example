# Copy to .env.hrms on the staging host and replace every placeholder.
HRMS_RELEASE_COMMIT=replace-with-git-commit
POSTGRES_DB=hrms_staging
POSTGRES_USER=hrms_staging
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=hrms.accerio.in,backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://hrms.accerio.in
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_CONN_HEALTH_CHECKS=true
# Amazon SES SMTP (Mumbai). Create SES SMTP credentials in ap-south-1 and
# inject the values only into the host-managed .env.hrms file.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-with-ses-smtp-username
DJANGO_EMAIL_HOST_PASSWORD=replace-with-ses-smtp-password
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=20
DJANGO_DEFAULT_FROM_EMAIL=Accerio HRMS <no-reply@accerio.in>
DJANGO_SERVER_EMAIL=Accerio HRMS <no-reply@accerio.in>
HRMS_NOTIFICATION_PROCESSOR_ENABLED=true
HRMS_DATA_ERASURE_EXECUTION_ENABLED=false
DATA_ERASURE_EXECUTION_ENABLED=false
HRMS_ENABLE_DEMO_DATA=false
HRMS_PUBLIC_APP_URL=https://hrms.accerio.in
HRMS_PAYROLL_LIVE_RAILS_ENABLED=false
