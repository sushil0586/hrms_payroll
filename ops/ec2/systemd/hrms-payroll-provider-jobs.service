[Unit]
Description=Process HRMS payroll provider jobs
After=network-online.target postgresql.service hrms-payroll-backend.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/hrms-payroll-saas/current/backend
EnvironmentFile=/var/www/hrms-payroll-saas/shared/backend.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/var/www/hrms-payroll-saas/current/backend/.venv/bin/python manage.py process_payroll_provider_jobs --limit 100 --lease-owner-ref ec2.systemd.payroll-provider-jobs
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/hrms-payroll-saas/shared /var/www/hrms-payroll-saas/current/backend/media
