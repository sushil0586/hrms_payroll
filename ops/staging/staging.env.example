# Configuration contract only. Inject real values from a staging secret manager.
HRMS_BACKEND_IMAGE=registry.invalid/hrms-backend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
HRMS_WEB_IMAGE=registry.invalid/hrms-web@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-from-secret-manager
DJANGO_ALLOWED_HOSTS=staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.com
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
HRMS_ENABLE_DEMO_DATA=false
HRMS_STAGING_ENVIRONMENT_FINGERPRINT=replace-with-opaque-deployment-fingerprint
HRMS_STAGING_EVIDENCE_DB_ROLE=replace-with-approved-evidence-role
HRMS_STAGING_EVIDENCE_API_ENABLED=false
HRMS_STAGING_EVIDENCE_API_ACTORS=replace-with-dedicated-qa-username
HRMS_STAGING_SYNTHETIC_EMAIL_DOMAINS=playwright.qa.invalid
HRMS_STAGING_SYNTHETIC_CLEANUP_ENABLED=false
HRMS_STAGING_EMAIL_ALLOWED_RECIPIENTS=replace-with-exact-synthetic-recipient
DJANGO_EMAIL_TRANSPORT_BACKEND=django.core.mail.backends.smtp.EmailBackend
HRMS_DATA_ERASURE_EXECUTION_ENABLED=false
DATABASE_URL=postgresql://secret-ref@postgres.internal/hrms?sslmode=verify-full
REDIS_URL=rediss://secret-ref@redis.internal:6379/0
HRMS_BROKER_DURABILITY_MODE=managed-persistent
HRMS_DOCUMENT_STORAGE_PROVIDER=s3-compatible
HRMS_DOCUMENT_MALWARE_SCANNER_REF=replace-with-approved-scanner-ref
PAYROLL_ARTIFACT_STORAGE_CONTROL_VERIFICATION_MODE=strict
HRMS_PAYROLL_ARTIFACT_STORAGE_CREDENTIALS_JSON={"replace-with-credential-ref":{"provider_family":"s3","use_default_credentials":true}}
HRMS_PAYROLL_ARTIFACT_STORAGE_POLICIES_JSON={"replace-with-policy-ref":{"status":"verified"}}
HRMS_BACKUP_AGE_RECIPIENT=replace-with-age-public-recipient
HRMS_BACKUP_OFFSITE_URI=s3://replace-with-private-backup-bucket/hrms
HRMS_CENTRAL_LOGGING_ENABLED=true
HRMS_CENTRAL_LOG_DESTINATION=replace-with-central-log-destination
HRMS_ALERTMANAGER_ROUTE=replace-with-alert-route
HRMS_INCIDENT_OWNER=replace-with-on-call-owner
HRMS_DEPLOYMENT_STRATEGY=rolling
