{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/build/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/local-qa/types/**/*.ts",
    ".next/playwright-live/types/**/*.ts",
    ".next/playwright-phase3c-bank/types/**/*.ts",
    ".next/playwright-phase3c-lifecycle/types/**/*.ts",
    ".next/playwright-phase3e-employees/types/**/*.ts",
    ".next/playwright-phase4-lifecycle-flows/types/**/*.ts",
    ".next/playwright-phase4-lifecycle/types/**/*.ts",
    ".next/playwright-phase4-operational-rerun/types/**/*.ts",
    ".next/playwright-phase5-document-flows/types/**/*.ts",
    ".next/playwright-phase5-documents-dynamic/types/**/*.ts",
    ".next/playwright-phase5-documents-rerun/types/**/*.ts",
    ".next/playwright-phase5-documents-rerun2/types/**/*.ts",
    ".next/playwright-phase5-documents/types/**/*.ts",
    ".next/playwright-phase5b-time-leave/types/**/*.ts",
    ".next/playwright-phase6a-payroll-readiness/types/**/*.ts",
    ".next/playwright-phase6b-payroll-contract/types/**/*.ts",
    ".next/playwright-phase6c0-payroll-nav/types/**/*.ts",
    ".next/playwright-phase6c1-form-a11y/types/**/*.ts",
    ".next/playwright-phase6c1-payroll-setup-a11y/types/**/*.ts",
    ".next/playwright-phase6c1-payroll-setup/types/**/*.ts",
    ".next/playwright-phase6c1-payroll-ui/types/**/*.ts",
    ".next/playwright-phase6c2-payroll-ui/types/**/*.ts",
    ".next/playwright-phase6c2-salary-a11y/types/**/*.ts",
    ".next/playwright-phase6c2-salary-setup/types/**/*.ts",
    ".next/playwright-phase6c3-payroll-rules/types/**/*.ts",
    ".next/playwright/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next/playwright-phase6c3-payroll-ui/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
